<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3B0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top bar: title + Badge button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tap a District"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#B71C1C" />

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="70dp"
                android:layout_height="44dp"
                android:text="Badge"
                android:textSize="10sp"
                android:backgroundTint="#FFC107"
                android:textColor="#7F0000" />

        </LinearLayout>

        <!-- Nearby Statues button -->
        <Button
            android:id="@+id/btnNearbyStatues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗿  Nearby Hero Statues &amp; Landmarks"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- Logout button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtBadgeDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textColor="#000000"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Karnataka map with district buttons -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="720dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/imgKarnatakaMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/karnataka_map"
                android:scaleType="fitCenter"
                android:contentDescription="Karnataka map" />

            <Button android:id="@+id/btnBidar" android:text="Bidar" style="@style/MapButton"
                android:layout_marginLeft="240dp" android:layout_marginTop="80dp" />

            <Button android:id="@+id/btnKalaburagi" android:text="Kalaburagi" style="@style/MapButton"
                android:layout_marginLeft="190dp" android:layout_marginTop="150dp" />

            <Button android:id="@+id/btnVijayapura" android:text="Bijapura" style="@style/MapButton"
                android:layout_marginLeft="120dp" android:layout_marginTop="200dp" />

            <Button android:id="@+id/btnYadgir" android:text="Yadgir" style="@style/MapButton"
                android:layout_marginLeft="245dp" android:layout_marginTop="200dp" />

            <Button android:id="@+id/btnBagalkote" android:text="Bagalkote" style="@style/MapButton"
                android:layout_marginLeft="95dp" android:layout_marginTop="255dp" />

            <Button android:id="@+id/btnBelagavi" android:text="Belagavi" style="@style/MapButton"
                android:layout_marginLeft="25dp" android:layout_marginTop="255dp" />

            <Button android:id="@+id/btnDharwad" android:text="Dharwad" style="@style/MapButton"
                android:layout_marginLeft="80dp" android:layout_marginTop="300dp" />

            <Button android:id="@+id/btnGadag" android:text="Gadag" style="@style/MapButton"
                android:layout_marginLeft="125dp" android:layout_marginTop="330dp" />

            <Button android:id="@+id/btnKoppal" android:text="Koppal" style="@style/MapButton"
                android:layout_marginLeft="170dp" android:layout_marginTop="290dp" />

            <Button android:id="@+id/btnRaichur" android:text="Raichur" style="@style/MapButton"
                android:layout_marginLeft="230dp" android:layout_marginTop="250dp" />

            <Button android:id="@+id/btnBallari" android:text="Ballari" style="@style/MapButton"
                android:layout_marginLeft="235dp" android:layout_marginTop="320dp" />

            <Button android:id="@+id/btnHaveri" android:text="Haveri" style="@style/MapButton"
                android:layout_marginLeft="100dp" android:layout_marginTop="360dp" />

            <Button android:id="@+id/btnUttaraKannada" android:text="U.Kannada" style="@style/MapButton"
                android:layout_marginLeft="30dp" android:layout_marginTop="355dp" />

            <Button android:id="@+id/btnDavanagere" android:text="Davanagere" style="@style/MapButton"
                android:layout_marginLeft="170dp" android:layout_marginTop="390dp" />

            <Button android:id="@+id/btnVijayanagara" android:text="Vijayanagara" style="@style/MapButton"
                android:layout_marginLeft="205dp" android:layout_marginTop="365dp" />

            <Button android:id="@+id/btnChitradurga" android:text="Chitradurga" style="@style/MapButton"
                android:layout_marginLeft="230dp" android:layout_marginTop="420dp" />

            <Button android:id="@+id/btnShivamogga" android:text="Shivamogga" style="@style/MapButton"
                android:layout_marginLeft="85dp" android:layout_marginTop="410dp" />

            <Button android:id="@+id/btnUdupi" android:text="Udupi" style="@style/MapButton"
                android:layout_marginLeft="40dp" android:layout_marginTop="475dp" />

            <Button android:id="@+id/btnChikkamagaluru" android:text="Chikkamagaluru" style="@style/MapButton"
                android:layout_marginLeft="115dp" android:layout_marginTop="445dp" />

            <Button android:id="@+id/btnDakshinaKannada" android:text="D.Kannada" style="@style/MapButton"
                android:layout_marginLeft="45dp" android:layout_marginTop="505dp" />

            <Button android:id="@+id/btnHassan" android:text="Hassan" style="@style/MapButton"
                android:layout_marginLeft="155dp" android:layout_marginTop="500dp" />

            <Button android:id="@+id/btnTumakuru" android:text="Tumakuru" style="@style/MapButton"
                android:layout_marginLeft="200dp" android:layout_marginTop="445dp" />

            <Button
                android:id="@+id/btnChikkaballapura"
                style="@style/MapButton"
                android:layout_marginLeft="270dp"
                android:layout_marginTop="455dp"
                android:text="Chikkaballapura" />

            <Button android:id="@+id/btnKolar" android:text="Kolar" style="@style/MapButton"
                android:layout_marginLeft="290dp" android:layout_marginTop="505dp" />

            <Button android:id="@+id/btnBengaluruRural" android:text="B.Rural" style="@style/MapButton"
                android:layout_marginLeft="225dp" android:layout_marginTop="480dp" />

            <Button
                android:id="@+id/btnBengaluruUrban"
                style="@style/MapButton"
                android:layout_marginLeft="270dp"
                android:layout_marginTop="530dp"
                android:text="Bengaluru" />

            <Button android:id="@+id/btnRamanagara" android:text="Ramanagara" style="@style/MapButton"
                android:layout_marginLeft="230dp" android:layout_marginTop="560dp" />

            <Button android:id="@+id/btnMandya" android:text="Mandya" style="@style/MapButton"
                android:layout_marginLeft="190dp" android:layout_marginTop="520dp" />

            <Button android:id="@+id/btnMysuru" android:text="Mysuru" style="@style/MapButton"
                android:layout_marginLeft="150dp" android:layout_marginTop="565dp" />

            <Button android:id="@+id/btnKodagu" android:text="Kodagu" style="@style/MapButton"
                android:layout_marginLeft="90dp" android:layout_marginTop="560dp" />

            <Button android:id="@+id/btnChamarajanagar" android:text="Chamarajanagar" style="@style/MapButton"
                android:layout_marginLeft="180dp" android:layout_marginTop="600dp" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>
